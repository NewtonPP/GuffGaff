# Vite picks the file by mode automatically:
#   npm run dev    -> .env.development
#   npm run build  -> .env.production
# Only VITE_-prefixed vars reach the browser bundle. Never put secrets here.

# Base URL of the GuffGaff signalling server.
VITE_SOCKET_URL=http://localhost:4000

# Comma-separated ICE servers used to discover a route between two peers.
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:global.stun.twilio.com:3478

# Optional TURN relay. STUN alone cannot connect peers behind symmetric NAT,
# so set these (from a TURN provider) if calls fail to connect in the wild.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
