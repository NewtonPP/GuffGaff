# Copy to .env for personal overrides. Committed defaults live in
# .env.development / .env.production and are chosen by NODE_ENV.

# Port the socket.io/HTTP server binds to.
# Render (and most PaaS hosts) inject their own PORT — leave it unset there.
PORT=4000

# Comma-separated list of browser origins allowed to connect (CORS).
CLIENT_ORIGINS=http://localhost:5173, http://127.0.0.1:5173
